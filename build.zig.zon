.{
    .name = .prometheus,
    .version = "0.0.0",
    .fingerprint = 0x579d3a7b46028a7c, // Changing this has security and trust implications.
    // The package builds on both, and a 0.16 user must not be turned away by a
    // version check. `.github/ci.yaml` keeps the 0.16 lane honest.
    .minimum_zig_version = "0.16.0",
    // Empty on purpose. The writer's only dependency is std, and the only sink
    // is `*std.Io.Writer`: no HTTP library gets to be step one.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
