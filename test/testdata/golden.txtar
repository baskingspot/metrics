values{case="one_tenth"} 0.1
values{case="ten_thousandth"} 0.0001
values{case="small"} 1e-07
values{case="nines"} 999999
values{case="million"} 1e+06
values{case="million_and_change"} 1.234567e+06
values{case="large"} 1e+21
values{case="huge"} 1e+300
values{case="three"} 3
values{case="third"} 0.3333333333333333
values{case="two_to_53"} 9.007199254740992e+15
values{case="min_normal"} 2.2250738585072014e-308
values{case="negative_zero"} -0
values{case="zero"} 0
values{case="nan"} NaN
values{case="inf"} +Inf
values{case="negative_inf"} -Inf
values{case="subnormal"} 5e-324
