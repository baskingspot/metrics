Prometheus golden documents. Each section is the exact bytes one family or one line writes, trailing newline included.

An input is Zig code, not text, so the sections hold expected output only; the call that produces each one is the test beside it in test/golden.zig.
-- labeled.expected --
# HELP requests_total Requests served, by method and status.
# TYPE requests_total counter
requests_total{method="GET",status="200"} 1841
requests_total{method="POST",status="500"} 3
-- unlabeled.expected --
# HELP up One per scrape.
# TYPE up gauge
up 1
-- line_only.expected --
up 1
-- integer_label.expected --
# HELP listener_port
# TYPE listener_port gauge
listener_port{port="5432"} 1
-- escape_label.expected --
# HELP worker_log
# TYPE worker_log counter
worker_log{message="say \"hi\"\nthen\\leave"} 1
-- escape_help.expected --
# HELP escaped a\\b"c\nd
# TYPE escaped gauge
escaped 1
-- empty_help.expected --
# HELP bare
# TYPE bare counter
bare 0
-- three_families.expected --
# HELP first_total First family.
# TYPE first_total counter
first_total{k="a"} 1
first_total{k="b"} 2
# HELP second
# TYPE second gauge
second 3
# HELP third_bytes
# TYPE third_bytes untyped
third_bytes 4
-- histogram_one_bucket.expected --
# HELP latency_seconds
# TYPE latency_seconds histogram
latency_seconds_bucket{le="10"} 3
latency_seconds_bucket{le="+Inf"} 3
latency_seconds_sum 5.5
latency_seconds_count 3
-- histogram_inf_only.expected --
# HELP latency_seconds
# TYPE latency_seconds histogram
latency_seconds_bucket{le="+Inf"} 7
latency_seconds_sum 1.25
latency_seconds_count 7
-- histogram_tail.expected --
